> ### Name: hash_keys32
> ### Title: Hash composite join keys to 32-bit integers (stable &
> ###   type-aware)
> ### Aliases: hash_keys32
> 
> ### ** Examples
> 
> if (interactive()) {
+   df <- data.frame(
+     id = c(1L, 2L, NA_integer_),
+     ts = as.POSIXct("2020-01-01", tz = "UTC") + 0:2,
+     value = c("a", "b", NA_character_),
+     stringsAsFactors = FALSE
+   )
+   hash_keys32(df, by = c("id", "ts", "value"))
+ }
> 
